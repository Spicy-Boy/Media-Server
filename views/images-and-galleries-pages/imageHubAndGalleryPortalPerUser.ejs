<!-- Name TOO descriptive? Nonsense.. this page is customized per logged-in user to present their uploads -->
<!DOCTYPE html>
<html>
<head>


    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Image Hub</title>

    <link rel="stylesheet" href="/css/style.css">
    <!-- <link rel="stylesheet" type="text/css" href="/css/galleryStyle.css"> -->

    <%
    let isThisActiveUserPage = false;
    if (activeUser.username == targetUser.username)
    {
        isThisActiveUserPage = true;
    }
    %>
    <script>
        let pageUsername = "<%=targetUser.username%>";
    </script>

</head>

<body style="background-color: #000000;" class="white">

    <%- include("../partials/userIndexHeader") %>

<div id="upload-and-console-wrapper" style="margin-left: auto; margin-right: auto; max-width: 95%;">

    <div id="image-uploading-container" class="flex-row flex-centered">

        <form class="suicune-form flex-column flex-centered smeargle-box" enctype="multipart/form-data" method="post">
            <h3 style="padding: 0; margin: 0;">UPLOAD IMAGES</h3>
            <img src="/images/smeargle.png">
            <div id="upload-files" style="margin-bottom: 15px;">
                <label for="images-input">Choose images to upload: </label>
                <br>
                <input id="images-input" name="uploaded_file" type="file" multiple class="auto-margins" style="  max-width: 66%;">
            </div>

            <input type="button" value="BEGIN UPLOAD" id="upload-button">
        </form>

    </div>

    <div id="console-container">
        
        <div id="console-header">
            <div id="console-header-title">
            Console
            </div>

        
            <div id="console-header-options">
                <label style="text-decoration: underline;" for="auto-snap-console-checkbox">Auto-Snap</label>
                <input style="" type="checkbox" id="auto-snap-console-checkbox" name="auto-snap-console-checkbox" checked>
            </div>

        </div>
        
        <!-- the console window uses class="console-entry" divs to present messages -->
        <div id="console-window">

            <div class="console-entry">
                > Hey you
            </div>
            <div class="console-entry">
                > yeah?
            </div>

        </div>
    </div>

</div>

<!-- vvv presents user's images organized either by date uploaded or internal modified date -->
<!-- either way, each image date container is a template that gets added to the display. The images themselves are not loaded unless the user presses the [+] plus button to load the thumbnails -->
 <!-- UPLOAD: images are uploaded in order and added to list view with temporary thumbnail. Then, after uploading, can choose to automatically generate thumbnails or skip -->
<!-- Every image/video needs its own page based on uuid that can present the image / video download link -->
<!-- LIST VIEW: display images/videos as downloadable links like in the user upload portal. When hover over link, show thumbnail of image -->
 <!-- GALLERY VIEW: display images/videos as square thumbnails arranged in a rectangle by dateUploaded or imageDate (date photo was taken/created)-->
 <!-- TODO: make videos downloadable, no stream yet.. generate thumbnail from video and option to set new custom thumbnail -->
  <!-- videoModel.js -->

<div id="images-display-wrapper">
    <div id="image-display-">

    </div>
</div>
    
</body>

<script src="/js/consoleScripts/updateConsoleWIndow.js"></script>

</html>